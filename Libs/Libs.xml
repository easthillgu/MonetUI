<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!-- MonetUI · Libs — 随包库（无硬依赖）
         顺序：LibStub 先立骨架；LibMonetColor-1.0 注册"配色引擎"；
         MonetColorMapData-1.0 是它要用的区域环境色数据包（同一 MAJOR，必须排在颜色库之后）；
         LibMonetColor-Anim-1.0 最后接动画层。四个都在 Core.lua 之前完成注册。 -->
    <Script file="LibStub\LibStub.lua"/>
    <Script file="LibMonetColor-1.0\LibMonetColor-1.0.lua"/>
    <Script file="MonetColorMapData-1.0\MonetColorMapData-1.0.lua"/>
    <Script file="LibMonetColor-Anim-1.0\LibMonetColor-Anim-1.0.lua"/>
</Ui>
