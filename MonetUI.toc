## SavedVariables: MonetUIDB

# ============================================================
# 加载清单：一个子模块 = 一份 xml
#   成组的文件（Libs / Utils / Config / 每个 Modules 目录）各有一份同名 xml，
#   组内顺序写在 xml 的 <Script file> 里；单文件模块直接在下面列 .lua。
#   要调加载顺序：改对应 xml，或在这里调换 xml 的位置 —— 别在 xml 之外加文件。
# ============================================================

# Libraries (LibStub / LibMonetColor-1.0 / 区域色数据包 / Anim)
Libs\Libs.xml

# Utilities (Math Secrets Media EventBus Color Widget Layout Mover Skin)
Utils\Utils.xml

# 启动前置配置：静态基线在加载期固定，编辑模式布局在模块 Initialize 之前一次性对齐。
# 必须在 Core.lua 之前 —— 它要在 PLAYER_LOGIN 的 StartModules 门闸上挂回调。
Init.lua

# Core (SavedVariables / 模块注册与生命周期 / 主题管线 / 斜杠命令)
Core.lua

# Config (设置面板)
Config\Config.xml

# Modules —— 这张表的顺序就是加载顺序
#   同组子文件的先后见各自 xml：UnitFrames 主文件先建 M.frames；ActionBars 主文件先导出共享件；
#   InfoBar 的 XP.lua 必须最后；Skins 注册顺序 = 设置面板里的排列顺序。
Modules\UnitFrames\UnitFrames.xml
Modules\Cooldown\Cooldown.xml
Modules\BuffFrame\BuffFrame.xml
Modules\Minimap\Minimap.xml
Modules\Bags\Bags.xml
Modules\QuestTracker\QuestTracker.xml
Modules\ActionBars\ActionBars.xml
Modules\Nameplates\Nameplates.xml
Modules\Tooltip\Tooltip.xml
# 工具模块：鼠标发光、耐久度、提示条、氛围暗角
# 暗角层（Atmosphere）必须在信息条之前加载：同 BACKGROUND 档、同层级时创建更晚的盖在上面。
# 信息条 / 小地图面板要压在暗角之上（两者都显式 SetFrameLevel(1) 写死了，这里只是第二道保险）。
Modules\Tools\Tools.xml
Modules\InfoBar\InfoBar.xml
# 模板数据库必须在皮肤引擎之前加载（TemplateDB -> TemplateRecognizer -> Skin:Recognize 查询）
Modules\Skins\Templates\Templates.xml
Modules\Skins\Skins.xml
