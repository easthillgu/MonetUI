<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!-- MonetUI · Modules/InfoBar — 屏幕边缘整幅细条 + 数据块 + 底边经验线
         顺序：InfoBar.lua 先建条（容器、底边衬线、显隐与悬停逻辑）；Blocks.lua 往条上挂六个数据块
         （金钱 / 耐久 / 货币 / 系统 / 专精 / 好友）；Currency.lua 提供货币自定义监控的数据层与
         右键勾选面板（运行时才被 Blocks 的货币块取用，必须在 Blocks 之后、等 M.Currency 就位）；
         XP.lua 拿那条衬线当经验条用，必须最后加载。 -->
    <Script file="InfoBar.lua"/>
    <Script file="Blocks.lua"/>
    <Script file="Currency.lua"/>
    <Script file="XP.lua"/>
</Ui>
